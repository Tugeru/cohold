# Required: Database connection string
# Leave empty for the in-memory demo fixtures.
DATABASE_URL=

# Local default: demo mode uses fixture personas and does not submit transactions.
# Set to wallet only after both contract and token IDs are configured below.
NEXT_PUBLIC_COHOLD_MODE=demo

# Cohold is Testnet-only for the MVP.
NEXT_PUBLIC_STELLAR_NETWORK=TESTNET

# Required for wallet mode. Both values must be valid Soroban contract IDs (C...).
NEXT_PUBLIC_STELLAR_CONTRACT_ID=
NEXT_PUBLIC_STELLAR_TOKEN_ID=
# Optional comma-separated additional wallet-mode treasury contract IDs.
NEXT_PUBLIC_STELLAR_CONTRACT_IDS=
# Optional override for the public Testnet RPC endpoint
# (defaults to https://soroban-testnet.stellar.org). Wallet diagnostics fail
# closed when this endpoint is unreachable or unhealthy.
NEXT_PUBLIC_STELLAR_RPC_URL=

# Live Testnet acceptance — non-public secret names, never values.
# Used only by the opt-in Testnet integration suite
# (src/lib/proposal-flow.testnet.test.ts) and the bootstrap workflow
# (scripts/testnet-bootstrap.mjs). Secrets stay in a private store; the
# public manifest at deployments/testnet.json holds no secret material.
COHOLD_TESTNET_CONTRACT_ID=
COHOLD_TESTNET_TOKEN_ID=
COHOLD_TESTNET_SECRET_A=
COHOLD_TESTNET_SECRET_B=
COHOLD_TESTNET_SECRET_C=
