# Required: Database connection string
# Leave empty for the in-memory demo fixtures.
DATABASE_URL=

# Local default: demo mode uses fixture personas and does not submit transactions.
# Set to wallet only after both contract and token IDs are configured below.
NEXT_PUBLIC_COHOLD_MODE=demo

# Cohold is Testnet-only for the MVP.
NEXT_PUBLIC_STELLAR_NETWORK=TESTNET

# Required for wallet mode. Both values must be valid Soroban contract IDs (C...).
NEXT_PUBLIC_STELLAR_CONTRACT_ID=
NEXT_PUBLIC_STELLAR_TOKEN_ID=
# Optional comma-separated additional wallet-mode treasury contract IDs.
NEXT_PUBLIC_STELLAR_CONTRACT_IDS=
