{
  "name": "nextjs-postgresql-template",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run lint && npm run typecheck && npm test",
    "contract:test": "cargo test",
    "contract:build": "stellar contract build --package cohold",
    "contract:bindings": "npm run contract:build && stellar contract bindings typescript --wasm target/wasm32v1-none/release/cohold.wasm --output-dir packages/cohold-contract --overwrite",
    "testnet:bootstrap": "node scripts/testnet-bootstrap.mjs",
    "testnet:matrix": "node scripts/testnet-matrix.mjs",
    "test:testnet": "npm run testnet:matrix",
    "test:walkthrough": "vitest run src/lib/mvp-walkthrough.testnet.test.ts"
  },
  "dependencies": {
    "@stellar/freighter-api": "^6.0.1",
    "@stellar/stellar-sdk": "^16.2.0",
    "@types/canvas-confetti": "^1.9.0",
    "buffer": "^6.0.3",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.31.0",
    "next": "16.2.6",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "postcss": "8.5.8",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  }
}
